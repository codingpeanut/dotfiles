{
  "bar": {
    "position": "left",
    "floating": true,
    "thickness": 44,
    "marginEdge": 8,
    "marginEnds": 12,
    "radius": 16,
    "backgroundOpacity": 0.85,
    "capsule": true,
    "capsuleRadius": 8,
    "capsulePadding": 6,
    "padding": 8,
    "widgetSpacing": 8,
    "widgets": {
      "left": [
        { "id": "Launcher", "type": "Launcher" },
        {
          "id": "Workspace",
          "type": "Workspace",
          "activePillSize": 2.8,
          "inactivePillSize": 1.2
        }
      ],
      "center": [
        { "id": "ActiveWindow", "type": "ActiveWindow" }
      ],
      "right": [
        { "id": "Media", "type": "Media" },
        { "id": "Tray", "type": "Tray" },
        { "id": "Clock", "type": "Clock", "format": "%H\n%M" },
        { "id": "Network", "type": "Network" },
        { "id": "Bluetooth", "type": "Bluetooth" },
        { "id": "Battery", "type": "Battery" },
        { "id": "Volume", "type": "Volume" },
        { "id": "Session", "type": "Session" }
      ]
    }
  },
  "controlCenter": {
    "sidebar": "full",
    "width": 880,
    "shortcuts": ["wifi", "bluetooth", "nightlight", "notification", "caffeine", "mic_mute", "wallpaper", "system"]
  },
  "notification": {
    "position": "top_right",
    "width": 430
  },
  "shell": {
    "fontFamily": "JetBrainsMono Nerd Font, Noto Sans CJK TC, sans-serif",
    "clipboardEnabled": true
  },
  "theme": {
    "mode": "dark",
    "shellMode": "dark",
    "name": "Caelestia-M3"
  }
}
