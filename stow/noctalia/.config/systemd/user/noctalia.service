[Unit]
Description=Noctalia Desktop Shell
Documentation=https://noctalia.dev
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=waybar.service mako.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/killall waybar mako
ExecStart=/usr/bin/noctalia
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
